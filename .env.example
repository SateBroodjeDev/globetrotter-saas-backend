# Database
DATABASE_URL=postgresql://user:password@localhost:5432/globetrotter_db
DATABASE_TEST_URL=postgresql://user:password@localhost:5432/globetrotter_test

# JWT & Security
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret
BCRYPT_ROUNDS=10

# Server
PORT=3000
NODE_ENV=production
API_URL=https://api.globetrotter.io
FRONTEND_URL=https://app.globetrotter.io

# Redis (for session/cache)
REDIS_URL=redis://localhost:6379

# Email (Sendgrid/Mailgun)
SENDGRID_API_KEY=your-sendgrid-key
MAIL_FROM=noreply@globetrotter.io

# Storage (AWS S3)
AWS_ACCESS_KEY_ID=your-aws-key
AWS_SECRET_ACCESS_KEY=your-aws-secret
AWS_REGION=eu-west-1
S3_BUCKET=globetrotter-uploads

# Stripe (Payment)
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_PUBLIC_KEY=pk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Sentry (Error tracking)
SENTRY_DSN=https://key@sentry.io/project-id

# External APIs
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
