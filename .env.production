# =============================================================================
# Globetrotter SaaS – Production Environment Template
# Copy to .env and fill in your values before deploying
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=******globetrotter_prod

# ── JWT & Security ────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_openssl_rand_base64_64
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=CHANGE_ME_openssl_rand_base64_64
BCRYPT_ROUNDS=12

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=production
API_URL=https://api.globetrotter.nl
FRONTEND_URL=https://app.globetrotter.nl
ADMIN_URL=https://admin.globetrotter.nl

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.CHANGE_ME
MAIL_FROM=noreply@globetrotter.nl

# ── Stripe Payments ───────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_CHANGE_ME
STRIPE_PUBLIC_KEY=pk_live_CHANGE_ME
STRIPE_WEBHOOK_SECRET=whsec_CHANGE_ME

# ── Sentry Error Tracking ─────────────────────────────────────────────────────
SENTRY_DSN=https://key@sentry.io/project-id

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_FORMAT=json

# ── External APIs ─────────────────────────────────────────────────────────────
OPEN_METEO_API_URL=https://api.open-meteo.com/v1
NOMINATIM_API_URL=https://nominatim.openstreetmap.org

# ── PostgreSQL (docker-compose) ───────────────────────────────────────────────
POSTGRES_DB=globetrotter_prod
POSTGRES_USER=globetrotter
POSTGRES_PASSWORD=CHANGE_ME_strong_password
